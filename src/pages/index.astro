---
title: "Lornychi | Streamer & Vtuber";
import "/src/styles/global.css";

let allImages = Object.entries(
	await import.meta.glob("/public/lornychi-art-*{webp,jpg,jpeg}", { eager: true }),
);

// Shuffle the gallery so the artwork order changes on each visit.
allImages = allImages.sort(() => Math.random() - 0.5);
